meta {
  name: Search asset
  type: http
  seq: 5
}

post {
  url: {{assetsUrl}}/services/search
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  q: id:{{tempTestAssetId}}
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.totalHits: eq 1
  res.body.hits[0].metadata.folderPath: eq {{tempTestFolder}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  WoodWing Helpcenter: [Assets Server REST API - create](https://helpcenter.woodwing.com/hc/en-us/articles/360042268771-Assets-Server-REST-API-create)
}
